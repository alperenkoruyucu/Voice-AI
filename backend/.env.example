PORT=3000

# DATABASE CONFIG
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_local_password_here
DB_NAME=my_project_db
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
NODE_ENV="development"

# AUTHENTICATION
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your_secure_password"
JWT_SECRET="your_jwt_secret_key"

# ==========================================
# IYZICO ÖDEME SİSTEMİ (SANDBOX / TEST)
# ==========================================
# İyzico Sandbox panelinden (Ayarlar -> Firma Ayarları) alınan anahtarlar
IYZICO_API_KEY="your_sandbox_api_key_here"
IYZICO_SECRET_KEY="your_sandbox_secret_key_here"
IYZICO_URI="https://sandbox-api.iyzipay.com"